def calcular_fuerza(masa_KG,aceleracion_m_s2):
    # Entrada de datos: masa en kilogramos y aceleración en metros por segundo al cuadrado
    masa_KG = float(input("Ingrese la masa en kilogramos: "))
    aceleracion_m_s2 = float(input("Ingrese la aceleración en metros por segundo al cuadrado: "))
    
    if masa_KG > 0 and aceleracion_m_s2 > 0:
        # Multiplicamos la masa por la aceleración para obtener la fuerza
        fuerza_N = masa_KG * aceleracion_m_s2
        # Devolvemos la fuerza calculada junto con los valores de entrada
        return fuerza_N, masa_KG, aceleracion_m_s2
    else:
        print("Error: La masa y la aceleración deben ser valores positivos mayores que cero.")
        return None, None, None
        
